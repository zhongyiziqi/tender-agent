APP_NAME=招标智能体后端
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/tender_agent.db
UPLOAD_DIR=./data/uploads
ARTIFACT_DIR=./data/artifacts
MAX_UPLOAD_MB=30
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_MAX_RESULTS=6
WEB_SEARCH_REGION=cn-zh
WEB_SEARCH_TIMEOUT_SECONDS=10

# mock 模式无需密钥。OpenAI、DeepSeek、Qwen 等兼容接口使用 openai_compatible。
LLM_MODE=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
MARKET_RESEARCH_MODEL=
TENDER_GENERATION_MODEL=
COMPLIANCE_REVIEW_MODEL=
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
